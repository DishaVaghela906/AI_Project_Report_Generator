# Supabase Database (Free database: https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Groq API (Free AI text generation: https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Hugging Face (Free diagram generation: https://huggingface.co/settings/tokens)
HF_API_KEY=your-huggingface-token
HF_IMAGE_MODEL=Maelstrome/mermaid-gemmma-7b

# Secret key for login security (any random string)
SECRET_KEY=change-this-to-a-random-secret-key-in-production
