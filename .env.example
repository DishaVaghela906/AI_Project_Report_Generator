# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# ─── LLM Provider (Choose: groq | huggingface | openrouter | ollama) ─────────────
LLM_PROVIDER=groq

# ─── Groq Configuration (Recommended — ultra-fast & free tier) ─────────────────
# Get free API key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=4096
# Available Groq models:
#   - openai/gpt-oss-120b (Recommended: 120B model, high token limits, no truncation)
#   - qwen/qwen3.8-27b

# ─── Hugging Face Inference API ────────────────────────────────────────────────
# Get token: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_huggingface_access_token_here
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
# Available HF models:
#   - Qwen/Qwen2.5-72B-Instruct
#   - Qwen/Qwen2.5-Coder-32B-Instruct
#   - Qwen/Qwen2.5-7B-Instruct

# ─── OpenRouter API ─────────────────────────────────────────────────────────────
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# ─── Ollama (Local fallback) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ─── Chapter API Keys (Optional override per chapter) ─────────────────────────
CHAPTER_1_API_KEY=default
CHAPTER_2_API_KEY=default
CHAPTER_3_API_KEY=default
CHAPTER_4_API_KEY=default
CHAPTER_5_API_KEY=default
CHAPTER_6_API_KEY=default

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./storage/chromadb

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=50

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=AI Report Generator
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-random-secret-key-in-production
